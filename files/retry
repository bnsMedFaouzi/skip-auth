def peek(self, n: int) -> list[str]:
    """First `n` non-empty lines (raw text), read cheaply without scanning the file."""
    out: list[str] = []
    with open(self._path, encoding="utf-8") as f:
        for line in f:
            if line.strip():
                out.append(line.rstrip("\n"))
                if len(out) >= n:
                    break
    return out
